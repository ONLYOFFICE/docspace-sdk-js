{
  "name": "@onlyoffice/docspace-sdk-js",
  "version": "2.2.0",
  "description": "Simple integration JavaScript SDK for ONLYOFFICE DocSpace",
  "license": "Apache-2.0",
  "homepage": "https://www.onlyoffice.com",
  "author": "Ascensio System SIA <integration@onlyoffice.com> (https://www.onlyoffice.com)",
  "maintainers": [
    "Ascensio System SIA <integration@onlyoffice.com> (https://www.onlyoffice.com)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ONLYOFFICE/docspace-sdk-js.git"
  },
  "bugs": {
    "url": "https://github.com/ONLYOFFICE/docspace-sdk-js/issues",
    "email": "support@onlyoffice.com"
  },
  "keywords": [
    "onlyoffice",
    "docspace",
    "sdk",
    "js-sdk",
    "iframe",
    "embed",
    "document-management",
    "file-manager",
    "editor",
    "collaboration",
    "document-editor",
    "rooms",
    "file-selector",
    "integration",
    "typescript"
  ],
  "main": "dist/cjs/main.js",
  "module": "dist/esm/main.js",
  "exports": {
    ".": {
      "types": "./dist/types/main.d.ts",
      "import": "./dist/esm/main.js",
      "require": "./dist/cjs/main.js"
    }
  },
  "types": "dist/types/main.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs": "node tools/update-revision.mjs && typedoc --options typedoc.config.mjs && node tools/docs/index.mjs && node tools/update-sidebar.mjs",
    "docs:sync": "pnpm run docs && node tools/sync-docs.mjs",
    "build": "node tools/build.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.10.1",
    "@vitest/coverage-v8": "3.1.4",
    "esbuild": "0.25.12",
    "eslint": "9.39.3",
    "jsdom": "26.1.0",
    "pnpm": "10.30.3",
    "typedoc": "0.28.17",
    "typedoc-docusaurus-theme": "1.4.2",
    "typedoc-plugin-frontmatter": "1.3.0",
    "typedoc-plugin-markdown": "4.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.3",
    "vitest": "3.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "brace-expansion": "^2.0.3",
      "flatted": ">=3.4.2",
      "micromatch>picomatch": ">=2.3.2 <3",
      "tinyglobby>picomatch": ">=4.0.4",
      "vite": ">=6.4.2 <7",
      "yaml": ">=2.8.3"
    }
  },
  "packageManager": "pnpm@10.30.3"
}
